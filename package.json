    "eslint-config-next": "16.3.5",
    "gray-matter": "^4.0.3",
    "image-size": "^1.2.1",
    "next": "16.3.5",
    "postcss": "^8.5.28",
    "prop-types": "^15.8.1",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-helmet": "^6.1.0",
    "rehype": "^12.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-stringify": "^9.0.4",
    "remark": "^14.0.3",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-html": "^15.0.2",
    "remark-parse": "^10.0.2",
    "remark-rehype": "^10.1.0",
    "shiki": "^3.23.0",
    "tailwindcss": "^4.3.3",
    "unified": "^10.1.2"
